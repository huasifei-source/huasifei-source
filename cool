#!/bin/sh
# OpenWrt 配置自动写入脚本（从 change_config 文件批量导入）
# 用法：在 OpenWrt 源码根目录下运行 rm tmp -rf && rm .config -> make menuconfig -> ./cool
set -e  # 遇到错误立即退出
CONFIG_FILE=".config"
CHANGE_FILE="change_config"   # 包含配置项的文件，每行格式：CONFIG_KEY=y 或 CONFIG_KEY=value
# 函数：写入或启用某个配置项
# 参数1：配置项名称（如 CONFIG_LUCI_LANG_zh_Hans）
# 参数2：配置值（如 y）
set_config() {
    local key="$1"
    local val="$2"
    local line="${key}=${val}"
    if grep -q "^${key}=" "${CONFIG_FILE}"; then
        echo "[跳过] ${key} 已设置为 $(grep "^${key}=" "${CONFIG_FILE}")"
    elif grep -q "^# ${key} is not set" "${CONFIG_FILE}"; then
        sed -i "s/^# ${key} is not set/${line}/" "${CONFIG_FILE}"
        echo "[修改] 已将 ${key} 从未设置改为 ${line}"
    else
        echo "${line}" >> "${CONFIG_FILE}"
        echo "[新增] 已添加 ${line}"
    fi
}

# 函数：禁用某个配置项（将 CONFIG_KEY=y 改为 # CONFIG_KEY is not set）
set_config_unset() {
    local key="$1"
    local not_set_line="# ${key} is not set"
    if grep -q "^# ${key} is not set" "${CONFIG_FILE}"; then
        echo "[跳过] ${key} 已经是未设置状态"
    elif grep -q "^${key}=" "${CONFIG_FILE}"; then
        sed -i "s/^${key}=.*/${not_set_line}/" "${CONFIG_FILE}"
        echo "[修改] 已将 ${key} 从启用改为未设置"
    else
        echo "${not_set_line}" >> "${CONFIG_FILE}"
        echo "[新增] 已添加 ${not_set_line}"
    fi
}

apply_patches() {
    local patches_dir="./patches"
    if [ -d "${patches_dir}/feeds" ]; then
        cp -rpf "${patches_dir}/feeds/." ./feeds/
        echo "  [patch] applied"
    fi
}




# 主执行函数
main() {
    # 检查 .config 文件是否存在
    if [ ! -f "${CONFIG_FILE}" ]; then
        echo "错误：未找到 ${CONFIG_FILE}，请先执行 make menuconfig 生成配置。"
        exit 1
    fi
    # 检查 change_config 文件是否存在
    if [ ! -f "${CHANGE_FILE}" ]; then
        echo "错误：未找到 ${CHANGE_FILE}，请创建该文件并填入需要修改的配置项。"
        exit 1
    fi
    echo "开始从 ${CHANGE_FILE} 读取配置并应用到 ${CONFIG_FILE}..."
    while IFS= read -r raw_line; do
        # 去掉首尾空白
        line=$(echo "${raw_line}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        # 跳过空行
        if [ -z "${line}" ]; then
            continue
        fi
        # 检测"禁用配置"格式: # CONFIG_XXX is not set（必须在删除注释之前处理）
        if echo "${line}" | grep -q '^# .* is not set$'; then
            key=$(echo "${line}" | sed 's/^# //; s/ is not set$//')
            set_config_unset "${key}"
            continue
        fi
        # 删除行内注释（# 及之后的内容）
        line=$(echo "${line}" | sed 's/#.*$//')
        # 再次去掉尾部空白（注释位置可能留下空格）
        line=$(echo "${line}" | sed 's/[[:space:]]*$//')
        key=$(echo "${line}" | cut -d'=' -f1)
        val=$(echo "${line}" | cut -d'=' -f2-)
        # 基本格式检查
        if [ -z "${key}" ] || [ -z "${val}" ]; then
            echo "[警告] 跳过格式不正确的行: ${raw_line}"
            continue
        fi
        set_config "${key}" "${val}"
    done < "${CHANGE_FILE}"
    echo "=============================="
    echo "========apply_patches========="
    apply_patches
    echo "=============================="
    echo "开始编译（使用 $(nproc) 个线程）..."
    make V=s -j$(nproc)
}
main "$@"
