+extern int rtl8221b_load_firmware_patch(struct phy_device *phydev);
+/* Early RTL8221B SerDes firmware patch - vendor rtl822x_init() equivalent.
+ * The vendor loads the SerDes ramcode and pins the SerDes option mode at
+ * ethernet probe time, BEFORE copper autoneg completes; loading it later
+ * (phylink config_init) leaves the SerDes dead on boards with crossed
+ * SerDes pairs (WS1610) when the cable is linked during boot.
+ * Verbose on purpose: a single boot log shows the full bring-up chain.
+ */
+static void mtk_early_rtl8221b_init(struct mtk_eth *eth)
+{
+	struct phy_device *phydev;
+	int addr, val;
+	bool found = false;
+
+	if (!of_machine_is_compatible("huasifei,ws1610"))
+		return;
+
+	for (addr = 0; addr < PHY_MAX_ADDR; addr++) {
+		phydev = mdiobus_get_phy(eth->mii_bus, addr);
+		if (!phydev)
+			continue;
+
+		dev_info(eth->dev,
+				 "wan dbg: mdio %d phy_id=0x%08x c45=%d mmd1_id=0x%08x\n",
+				 addr, phydev->phy_id, phydev->is_c45,
+				 phydev->c45_ids.device_ids[MDIO_MMD_PMAPMD]);
+
+		/* C45 devices keep their ID in c45_ids.device_ids[MMD1],
+		 * not phy_id (see rtlgen_is_c45_match) - check both.
+		 */
+		if (phydev->phy_id != 0x001cc849 &&
+		    phydev->c45_ids.device_ids[MDIO_MMD_PMAPMD] != 0x001cc849)
+			continue;
+		found = true;
+
+		dev_info(eth->dev,
+				 "wan patch test v3: RTL8221B early init (mdio addr %d)\n",
+				 addr);
+
+		/* Pin the SerDes option mode first (vendor order): the
+		 * register write does not stick once the patched SerDes
+		 * controller is running.
+		 */
+		val = phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x75f3);
+		dev_info(eth->dev, "wan dbg: 0x75f3=0x%04x\n", val);
+		if (val >= 0)
+			phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x75f3,
+					      val & ~BIT(0));
+
+		val = phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x697a);
+		dev_info(eth->dev, "wan dbg: 0x697a=0x%04x, pinning 0x8002\n", val);
+		if (val >= 0)
+			phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x697a,
+					      (val & ~0x3f) | 0x2 | BIT(15));
+		dev_info(eth->dev, "wan dbg: 0x697a now=0x%04x\n",
+			 phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x697a));
+
+		dev_info(eth->dev, "wan dbg: copper stat1=0x%04x (bit2=link)\n",
+			 phy_read_mmd(phydev, MDIO_MMD_PMAPMD, MDIO_STAT1));
+
+		msleep(500);
+
+		val = phy_read_mmd(phydev, MDIO_MMD_AN, MDIO_CTRL1);
+		if (val >= 0)
+			phy_write_mmd(phydev, MDIO_MMD_AN, MDIO_CTRL1, val | BIT(9));
+
+		msleep(500);
+
+		rtl8221b_load_firmware_patch(phydev);
+		break;
+	}
+
+	if (!found)
+		dev_info(eth->dev,
+				 "wan patch test v3: RTL8221B not found on mdio bus\n");
+}
