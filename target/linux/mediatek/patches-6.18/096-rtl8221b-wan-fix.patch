 static int rtl822xb_config_init(struct phy_device *phydev)
 {
+	int ret;
+
+	/* Upload the Realtek SerDes firmware patch before configuring the
+	 * SerDes option mode; skipped automatically on non-RTL8221B PHYs
+	 * and on already-patched silicon.
+	 */
+	ret = rtl8221b_load_firmware_patch(phydev);
+	if (ret < 0)
+		return ret;
+
 	return rtl822x_set_serdes_option_mode(phydev, false);
 }
 
