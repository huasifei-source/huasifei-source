+static int rtl_w(struct phy_device *phydev, int dev, u16 reg, u16 val)
+{
+	int ret = phy_write_mmd(phydev, dev, reg, val);
+
+	if (ret < 0)
+		return ret;
+	return 0;
+}
+
+static int rtl_r(struct phy_device *phydev, int dev, u16 reg, u16 *val)
+{
+	int ret = phy_read_mmd(phydev, dev, reg);
+
+	if (ret < 0)
+		return ret;
+	*val = (u16)ret;
+	return 0;
+}
+
+static int rtl_wait_bit(struct phy_device *phydev, u16 reg, u16 mask,
+			bool set, unsigned int timeout_ms)
+{
+	unsigned int i;
+
+	for (i = 0; i < timeout_ms; i++) {
+		u16 v;
+		int ret = rtl_r(phydev, MDIO_MMD_VEND2, reg, &v);
+
+		if (ret)
+			return ret;
+		if (!set)
+			v = ~v;
+		if ((v & mask) == mask)
+			return 0;
+		msleep(1);
+	}
+	return -ETIMEDOUT;
+}
