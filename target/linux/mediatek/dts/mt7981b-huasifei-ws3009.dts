/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7981b.dtsi"

/ {
	model = "Huasifei WS3009";
	compatible = "huasifei,ws3009", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_running;
		led-upgrade = &led_sys;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		reg = <0 0x40000000 0 0x40000000>;
		device_type = "memory";
	};

	// WS3009 has 3x M.2 5G modules:
	// - GPIO4:  Mod1 reset  (active high, low during work)
	// - GPIO12: Mod2 reset  (active high, low during work)
	// - GPIO8:  Mod3 reset  (active high, low during work)
	// - GPIO5:  Mod1 & Mod2 power  (active high)
	// - GPIO13: Mod3 power / FAN-FG alt (active high)
	gpio-export {
		compatible = "gpio-export";

		modem1-reset {
			gpio-export,name = "modem1_reset";
			gpio-export,output = <0>;
			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
		};

		modem2-reset {
			gpio-export,name = "modem2_reset";
			gpio-export,output = <0>;
			gpios = <&pio 12 GPIO_ACTIVE_LOW>;
		};

		modem3-reset {
			gpio-export,name = "modem3_reset";
			gpio-export,output = <0>;
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		modem-pwr12 {
			gpio-export,name = "modem_pwr12";
			gpio-export,output = <1>;
			gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		};

		modem-pwr3 {
			gpio-export,name = "modem_pwr3";
			gpio-export,output = <1>;
			gpios = <&pio 13 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};
	};

	// WS3009 LED mapping (RGB + 3 network):
	// GPIO0  = Red   (system status)
	// GPIO10 = Green (running)
	// GPIO11 = Blue  (network / RGB blue component)
	// GPIO6  = 5G1 modem LED
	// GPIO7  = 5G2 modem LED
	// GPIO9  = 5G3 modem LED
	gpio-leds {
		compatible = "gpio-leds";

		led_sys: led-0 {
			label = "red:status";
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
		};

		led_running: led-1 {
			label = "green:running";
			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			label = "blue:network";
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "green:5g1";
			gpios = <&pio 6 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			label = "green:5g2";
			gpios = <&pio 7 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			label = "green:5g3";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};
	};
};

// WS3009 network topology:
//
// gmac0 → 2500base-x → MT7531 CPU (port6)
//   ├── port0 → lan1
//   ├── port1 → lan2
//   ├── port2 → lan3
//   └── port3 → lan4
// gmac1 → gmii → WAN PHY(mdio:0) → WAN
//
// Note: Unlike WS3006 where WAN is on switch port5 and lan3 is on gmac1,
// WS3009 has all 4 LAN on the switch and WAN directly on gmac1.

&eth {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		nvmem-cells = <&macaddr_factory_4 1>;
		nvmem-cell-names = "mac-address";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&wan_phy>;
		nvmem-cells = <&macaddr_factory_4 2>;
		nvmem-cell-names = "mac-address";
		label = "wan";
	};
};

&mdio_bus {
	reset-gpios = <&pio 14 GPIO_ACTIVE_LOW>;
	reset-delay-us = <100000>;
	reset-post-delay-us = <100000>;

	wan_phy: ethernet-phy@0 {
		compatible = "ethernet-phy-id03a2.9461";
		reg = <0>;
		phy-mode = "gmii";
		nvmem-cells = <&phy_cal_factory>;
		nvmem-cell-names = "phy-cal-data";
	};

	switch: switch@1f {
		compatible = "mediatek,mt7531";
		reg = <31>;
		reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&pio>;
		interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "lan1";
				nvmem-cells = <&macaddr_factory_4 1>;
				nvmem-cell-names = "mac-address";
			};

			port@1 {
				reg = <1>;
				label = "lan2";
				nvmem-cells = <&macaddr_factory_4 1>;
				nvmem-cell-names = "mac-address";
			};

			port@2 {
				reg = <2>;
				label = "lan3";
				nvmem-cells = <&macaddr_factory_4 1>;
				nvmem-cell-names = "mac-address";
			};

			port@3 {
				reg = <3>;
				label = "lan4";
				nvmem-cells = <&macaddr_factory_4 1>;
				nvmem-cell-names = "mac-address";
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		spi-max-frequency = <52000000>;
		spi-tx-buswidth = <4>;
		spi-rx-buswidth = <4>;

		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x100000 0x80000>;
			};

			partition@180000 {
				label = "Factory";
				reg = <0x180000 0x200000>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1000>;
					};

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};

					phy_cal_factory: calib@8dc {
						reg = <0x8dc 0x10>;
					};
				};
			};

			partition@380000 {
				label = "FIP";
				reg = <0x380000 0x200000>;
				read-only;
			};

			partition@580000 {
				label = "ubi";
				reg = <0x580000 0xe280000>;
			};
		};
	};
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&wifi {
	status = "okay";
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";

	band@0 {
		reg = <0>;
		nvmem-cells = <&macaddr_factory_4 0>;
		nvmem-cell-names = "mac-address";
	};
};

&usb_phy {
	status = "okay";
};

&xhci {
	status = "okay";
};
