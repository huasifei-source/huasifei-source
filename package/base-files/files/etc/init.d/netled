#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
. /lib/functions/leds.sh

while true; do
    RED_LED=$(get_dt_led boot)
    BLUE_LED=$(get_dt_led running)

    if [ -n "$RED_LED" ] || [ -n "$BLUE_LED" ]; then
        if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
            led_timer "$RED_LED" 1000 1000 2>/dev/null
            led_timer "$BLUE_LED" 1000 1000 2>/dev/null
        else
            led_off "$RED_LED" 2>/dev/null
            led_on "$BLUE_LED" 2>/dev/null
        fi
    fi
    sleep 10
done
'
    procd_set_param respawn
    procd_close_instance
}
