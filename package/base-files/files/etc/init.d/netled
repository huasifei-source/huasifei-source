#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
. /lib/functions/leds.sh

# 检测机型
MODEL=$(cat /proc/device-tree/model 2>/dev/null | tr -d "\0")

# ============================================================
# 1698 机型：WiFi + 4G/5G 网络灯 + ping 外网检测
# ============================================================
if [ "$MODEL" = "HUASIFEI WS1698" ]; then

    # 找 qmodem 缓存文件（动态获取 config section 名）
    find_cache() {
        MODEM_SECTION=$(uci show qmodem 2>/dev/null | grep "=modem-device" | head -1 | cut -d"=" -f1 | cut -d"." -f2)
        [ -n "$MODEM_SECTION" ] && echo "/tmp/cache_info_${MODEM_SECTION}"
    }

    # LED 名（需与 DTS 中 label 一致）
    WIFI_LED="green:wifi"
    LED_5G_O="amber:5g"
    LED_5G_G="green:5g"
    LED_4G_G="green:4g"
    LED_4G_O="amber:4g"

    # 启动时先全灭
    for led in "$WIFI_LED" "$LED_4G_O" "$LED_4G_G" "$LED_5G_O" "$LED_5G_G"; do
        led_off "$led" 2>/dev/null
    done

    while true; do
        # ---- WiFi 灯 ----
        WIFI_UP=$(iwinfo 2>/dev/null | grep -c "ESSID")
        if [ "$WIFI_UP" -gt 0 ] 2>/dev/null; then
            led_on "$WIFI_LED" 2>/dev/null
        else
            led_off "$WIFI_LED" 2>/dev/null
        fi

        # ---- 网络灯 ----
        CACHE_FILE=$(find_cache)
        NET_TYPE=""

        if [ -f "$CACHE_FILE" ]; then
            NET_TYPE=$(jsonfilter -i "$CACHE_FILE" -e "@.modem_info[@.key=\"Network Type\"].value" 2>/dev/null)
        fi

        # 先关所有网络灯
        led_off "$LED_4G_O" 2>/dev/null
        led_off "$LED_4G_G" 2>/dev/null
        led_off "$LED_5G_O" 2>/dev/null
        led_off "$LED_5G_G" 2>/dev/null

        # ping 通外网才亮灯
        if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
            case "$NET_TYPE" in
                *LTE*)
                    led_on "$LED_4G_O" 2>/dev/null
                    led_on "$LED_4G_G" 2>/dev/null
                    ;;
                *NR*|*NR5G*)
                    led_on "$LED_5G_O" 2>/dev/null
                    led_on "$LED_5G_G" 2>/dev/null
                    ;;
            esac
        fi

        sleep 10
    done

# ============================================================
# WS3009 RGB 三色灯：开机绿灯，联网后绿灯+蓝灯同亮
# ============================================================
elif [ "$MODEL" = "Huasifei WS3009" ]; then
    RED_LED="red:status"
    GREEN_LED="green:running"
    BLUE_LED="blue:network"

    # 开机完成：红灯灭，绿灯亮
    led_off "$RED_LED" 2>/dev/null
    led_on "$GREEN_LED" 2>/dev/null

    while true; do
        if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
            # 已联网：绿灯 + 蓝灯同亮
            led_on "$GREEN_LED" 2>/dev/null
            led_on "$BLUE_LED" 2>/dev/null
        else
            # 未联网：仅绿灯亮
            led_on "$GREEN_LED" 2>/dev/null
            led_off "$BLUE_LED" 2>/dev/null
        fi
        sleep 10
    done
# ============================================================
# TRS_Router_Mini RGB 开机正常亮绿灯,网络中断亮红灯
# ============================================================
elif [ "$MODEL" = "Huasifei TRS_Router_MiniUPS" ]; then
    RED_LED="red:status"
    GREEN_LED="green:sys"
    

    # 开机完成：都灭
    led_off "$RED_LED" 2>/dev/null
    led_off "$GREEN_LED" 2>/dev/null

    while true; do
        if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
            # 已联网：绿灯常亮
            led_on "$GREEN_LED" 2>/dev/null
            led_off "$RED_LED" 2>/dev/null
        else
            # 未联网：红灯常亮
            led_off "$GREEN_LED" 2>/dev/null
            led_on "$RED_LED" 2>/dev/null
        fi
        sleep 10
    done 

# ============================================================
# WH3000 Pro eMMC / WH3000 eMMC：原有逻辑（红蓝灯 ping 闪烁）
# 严格匹配 model 全串，其余机型（含 WH3000R）一律不接管
# ============================================================
elif [ "$MODEL" = "Huasifei WH3000 Pro eMMC" ] || [ "$MODEL" = "Huasifei WH3000 eMMC" ]; then

    while true; do
        RED_LED=$(get_dt_led boot)
        BLUE_LED=$(get_dt_led running)

        if [ -n "$RED_LED" ] || [ -n "$BLUE_LED" ]; then
            if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
                led_timer "$RED_LED" 1000 1000 2>/dev/null
                led_timer "$BLUE_LED" 1000 1000 2>/dev/null
            else
                led_off "$RED_LED" 2>/dev/null
                led_on "$BLUE_LED" 2>/dev/null
            fi
        fi
        sleep 10
    done

# ============================================================
# 其它机型（含 WH3000R）：不做接管
# 灯由 DTS aliases（diag.sh 开机状态机）与 uci netdev 触发器自管
# ============================================================
else

    # 保持常驻但不操作任何灯（直接退出会触发 procd respawn 反复拉起）
    while true; do sleep 3600; done

fi
'
    procd_set_param respawn
    procd_close_instance
}
